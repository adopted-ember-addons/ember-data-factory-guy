{
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adopted-ember-addons/ember-data-factory-guy.git",
    "directory": "addon"
  },
  "workspaces": [
    "addon",
    "test-app"
  ],
  "scripts": {
    "test": "pnpm --filter ember-data-factory-guy build && pnpm --filter test-app test",
    "lint": "npm-run-all --aggregate-output --continue-on-error --parallel \"lint:!(fix)\"",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:hbs": "ember-template-lint .",
    "lint:prettier": "prettier -c .",
    "lint:prettier:fix": "prettier -w ."
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-transform-class-properties": "^7.28.6",
    "ember-eslint-parser": "^0.5.13",
    "ember-template-lint": "^7.9.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "prettier-plugin-ember-template-tag": "^2.1.5",
    "release-plan": "^0.18.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "webpack"
      ]
    },
    "overrides": {
      "@embroider/addon-dev": "8.0.1",
      "testem": "3.18.0"
    },
    "patchedDependencies": {
      "active-model-adapter": "patches/active-model-adapter.patch"
    },
    "onlyBuiltDependencies": [
      "core-js",
      "fsevents",
      "msw"
    ]
  },
  "packageManager": "pnpm@10.12.1"
}
